# 3D AI Girlfriend Assistant - Environment Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# LLM Provider: "groq" | "ollama" | "gemini"
LLM_PROVIDER=groq

# Groq API (Primary - fastest for voice)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (Local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# TTS Configuration
TTS_VOICE=en-US-AvaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Memory System
MEMORY_ENABLED=true
MEMORY_COLLECTION=ai_assistant_conversations

# Character Personality
CHARACTER_NAME=AI Assistant
CHARACTER_PERSONALITY=Friendly, helpful, and expressive
SYSTEM_PROMPT=You are a friendly, helpful, and expressive 3D AI Assistant. Keep your answers natural, concise, and suitable for spoken dialogue.
